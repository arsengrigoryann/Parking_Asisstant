# Application
APP_ENV=local
LOG_LEVEL=INFO

# OpenAI (required for ingestion and semantic/hybrid retrieval)
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Static knowledge retrieval
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVAL_LIMIT=5
RAG_HYBRID_ALPHA=0.5
WEAVIATE_KNOWLEDGE_COLLECTION=PublicParkingKnowledge

# Reservation collection (format after spaces and hyphens are removed)
RESERVATION_CAR_NUMBER_PATTERN=^[A-Z0-9]{4,12}$

# LangSmith (optional tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-a-langsmith-api-key
LANGSMITH_PROJECT=parking-assistant-stage1
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# PostgreSQL
POSTGRES_DB=parking_assistant
POSTGRES_USER=parking_app
POSTGRES_PASSWORD=Parking123!
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://parking_app:Parking123!@localhost:5432/parking_assistant

# Weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_HTTP_URL=http://localhost:8080
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_SECURE=false
WEAVIATE_API_KEY=replace-with-a-local-api-key
